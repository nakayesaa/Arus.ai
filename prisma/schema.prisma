generator client {
  provider               = "prisma-client"
  output                 = "../apps/api/src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  OPERATOR
}

enum AccountTokenPurpose {
  INVITATION
  PASSWORD_RESET
}

enum InvoiceImportJobStatus {
  PREVIEWING
  READY
  COMMITTED
  FAILED
  CANCELLED
}

enum InvoiceImportRowResult {
  VALID
  INVALID
  DUPLICATE
  COMMITTED
}

enum InvoiceImportDebtorAction {
  MATCH_EXISTING
  WILL_CREATE
}

enum CommunicationChannel {
  WHATSAPP
  CALL
  EMAIL
  OTHER
}

enum WhatsAppProvider {
  META
}

enum WhatsAppConnectionState {
  DISCONNECTED
  LIVE
  PAUSED
  DEGRADED
}

enum ConversationMatchState {
  MATCHED
  UNMATCHED
  AMBIGUOUS
}

enum ChannelMessageDirection {
  INBOUND
  OUTBOUND
}

enum ChannelMessageType {
  TEXT
  IMAGE
}

enum ChannelMessageState {
  DRAFT
  APPROVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
  PROCESSING
  READY
}

enum MediaProcessingState {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum PaymentEvidenceState {
  PROCESSING
  AWAITING_REVIEW
  ACCEPTED
  REJECTED
  UNAVAILABLE
}

enum WebhookInboxState {
  PENDING
  PROCESSING
  COMPLETED
  RETRY
  FAILED
}

enum MessageOutboxState {
  PENDING
  PROCESSING
  SENT
  RETRY
  FAILED
}

enum PromiseFinalStatus {
  FULFILLED
  CANCELLED
}

enum DisputeCategory {
  MISSING_POD
  WRONG_AMOUNT
  WRONG_QUANTITY
  QUALITY
  ADMINISTRATIVE
  OTHER
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(200)
  timezone  String   @default("Asia/Jakarta") @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  memberships         Membership[]
  auditLogs           AuditLog[]
  accountTokens       AccountToken[]
  debtors             Debtor[]
  invoices            Invoice[]
  payments            Payment[]
  allocations         PaymentAllocation[]
  communications      Communication[]
  promises            PromiseToPay[]
  disputes            Dispute[]
  importJobs          InvoiceImportJob[]
  importRows          InvoiceImportRow[]
  whatsappConnections WhatsAppConnection[]
  conversationThreads ConversationThread[]
  channelMessages     ChannelMessage[]
  mediaAssets         MediaAsset[]
  evidenceReviews     PaymentEvidenceReview[]
  webhookInbox        WebhookInbox[]
  messageOutbox       MessageOutbox[]
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @db.VarChar(320)
  normalizedEmail String   @unique @db.VarChar(320)
  passwordHash    String?  @db.VarChar(100)
  name            String   @db.VarChar(200)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  memberships        Membership[]
  auditLogs          AuditLog[]              @relation("AuditActor")
  accountTokens      AccountToken[]
  createdPayments    Payment[]               @relation("PaymentCreator")
  createdAllocations PaymentAllocation[]     @relation("AllocationCreator")
  communications     Communication[]         @relation("CommunicationActor")
  createdPromises    PromiseToPay[]          @relation("PromiseCreator")
  cancelledPromises  PromiseToPay[]          @relation("PromiseCanceller")
  createdDisputes    Dispute[]               @relation("DisputeCreator")
  resolvedDisputes   Dispute[]               @relation("DisputeResolver")
  createdImportJobs  InvoiceImportJob[]      @relation("InvoiceImportCreator")
  approvedMessages   ChannelMessage[]        @relation("ChannelMessageApprover")
  evidenceReviews    PaymentEvidenceReview[] @relation("EvidenceReviewer")
}

model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  organizationId String         @db.Uuid
  role           MembershipRole
  isActive       Boolean        @default(true)
  invitedAt      DateTime?      @db.Timestamptz(3)
  acceptedAt     DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sessions     Session[]

  @@unique([userId, organizationId])
  @@index([organizationId, isActive])
}

model AccountToken {
  id             String              @id @default(uuid()) @db.Uuid
  tokenHash      String              @unique @db.VarChar(64)
  purpose        AccountTokenPurpose
  userId         String              @db.Uuid
  organizationId String              @db.Uuid
  expiresAt      DateTime            @db.Timestamptz(3)
  consumedAt     DateTime?           @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, purpose, expiresAt])
  @@index([userId, purpose, expiresAt])
}

model Session {
  id             String         @id @default(uuid()) @db.Uuid
  tokenHash      String         @unique @db.VarChar(64)
  userId         String         @db.Uuid
  organizationId String         @db.Uuid
  role           MembershipRole
  expiresAt      DateTime       @db.Timestamptz(3)
  revokedAt      DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  membership Membership @relation(fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  @@index([organizationId, expiresAt])
  @@index([userId, expiresAt])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  actorId        String?  @db.Uuid
  action         String   @db.VarChar(80)
  entityType     String?  @db.VarChar(80)
  entityId       String?  @db.Uuid
  requestId      String   @db.VarChar(128)
  metadata       Json?    @db.JsonB
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
}

model Debtor {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  code           String?   @db.VarChar(50)
  normalizedCode String?   @db.VarChar(50)
  name           String    @db.VarChar(200)
  normalizedName String    @db.VarChar(200)
  contactName    String?   @db.VarChar(200)
  phoneNumber    String?   @db.VarChar(50)
  email          String?   @db.VarChar(320)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)

  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoices            Invoice[]
  payments            Payment[]
  importRows          InvoiceImportRow[]      @relation("ImportMatchedDebtor")
  conversationThreads ConversationThread[]
  evidenceReviews     PaymentEvidenceReview[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, name])
  @@index([organizationId, normalizedName, deletedAt])
}

model Invoice {
  id                      String    @id @default(uuid()) @db.Uuid
  organizationId          String    @db.Uuid
  debtorId                String    @db.Uuid
  invoiceNumber           String    @db.VarChar(50)
  normalizedInvoiceNumber String    @db.VarChar(50)
  invoiceDate             DateTime  @db.Date
  dueDate                 DateTime  @db.Date
  originalAmount          Decimal   @db.Decimal(18, 2)
  description             String?   @db.VarChar(1000)
  createdAt               DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt               DateTime? @db.Timestamptz(3)

  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  debtor              Debtor                  @relation(fields: [debtorId], references: [id], onDelete: Restrict)
  allocations         PaymentAllocation[]
  communications      Communication[]
  promises            PromiseToPay[]
  disputes            Dispute[]
  importRow           InvoiceImportRow?       @relation("CommittedInvoice")
  conversationThreads ConversationThread[]    @relation("CurrentInvoiceThread")
  channelMessages     ChannelMessage[]
  evidenceReviews     PaymentEvidenceReview[]

  @@index([organizationId, dueDate])
  @@index([organizationId, debtorId])
  @@index([organizationId, deletedAt])
}

model Communication {
  id               String               @id @default(uuid()) @db.Uuid
  organizationId   String               @db.Uuid
  invoiceId        String               @db.Uuid
  actorId          String               @db.Uuid
  actorRole        MembershipRole
  operationKey     String               @db.Uuid
  occurredAt       DateTime             @db.Timestamptz(3)
  channel          CommunicationChannel
  notes            String               @db.VarChar(2000)
  nextFollowUpDate DateTime?            @db.Date
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  actor        User         @relation("CommunicationActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([organizationId, operationKey])
  @@index([organizationId, invoiceId, occurredAt])
  @@index([organizationId, createdAt])
}

model PromiseToPay {
  id                       String              @id @default(uuid()) @db.Uuid
  organizationId           String              @db.Uuid
  invoiceId                String              @db.Uuid
  amount                   Decimal             @db.Decimal(18, 2)
  promiseDate              DateTime            @db.Date
  createdById              String              @db.Uuid
  createdByRole            MembershipRole
  operationKey             String              @db.Uuid
  finalStatus              PromiseFinalStatus?
  fulfilledAt              DateTime?           @db.Timestamptz(3)
  cancelledAt              DateTime?           @db.Timestamptz(3)
  cancelledById            String?             @db.Uuid
  cancelledByRole          MembershipRole?
  cancelReason             String?             @db.VarChar(500)
  cancellationOperationKey String?             @db.Uuid
  createdAt                DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime            @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("PromiseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy  User?        @relation("PromiseCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)

  @@unique([organizationId, operationKey], map: "PromiseToPay_org_operation_key")
  @@unique([organizationId, cancellationOperationKey], map: "PromiseToPay_org_cancel_operation_key")
  @@index([organizationId, invoiceId, promiseDate])
  @@index([organizationId, finalStatus, promiseDate])
}

model Dispute {
  id                     String          @id @default(uuid()) @db.Uuid
  organizationId         String          @db.Uuid
  invoiceId              String          @db.Uuid
  category               DisputeCategory
  details                String          @db.VarChar(2000)
  status                 DisputeStatus   @default(OPEN)
  createdById            String          @db.Uuid
  createdByRole          MembershipRole
  operationKey           String          @db.Uuid
  resolvedById           String?         @db.Uuid
  resolvedByRole         MembershipRole?
  resolvedAt             DateTime?       @db.Timestamptz(3)
  resolutionNote         String?         @db.VarChar(1000)
  resolutionOperationKey String?         @db.Uuid
  createdAt              DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("DisputeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  resolvedBy   User?        @relation("DisputeResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, operationKey], map: "Dispute_org_operation_key")
  @@unique([organizationId, resolutionOperationKey], map: "Dispute_org_resolution_operation_key")
  @@index([organizationId, invoiceId, status, createdAt])
  @@index([organizationId, status, createdAt])
}

model Payment {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  debtorId         String   @db.Uuid
  paymentDate      DateTime @db.Date
  amount           Decimal  @db.Decimal(18, 2)
  payerReference   String?  @db.VarChar(100)
  bankReference    String?  @db.VarChar(100)
  operationKey     String?  @db.Uuid
  isOpeningBalance Boolean  @default(false)
  createdById      String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  debtor         Debtor                 @relation(fields: [debtorId], references: [id], onDelete: Restrict)
  createdBy      User                   @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  allocations    PaymentAllocation[]
  evidenceReview PaymentEvidenceReview?

  @@unique([organizationId, operationKey], map: "Payment_org_operation_key")
  @@index([organizationId, paymentDate, id])
  @@index([organizationId, debtorId])
}

model PaymentAllocation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  paymentId      String    @db.Uuid
  invoiceId      String    @db.Uuid
  amount         Decimal   @db.Decimal(18, 2)
  allocationDate DateTime  @db.Date
  createdById    String    @db.Uuid
  reversedAt     DateTime? @db.Timestamptz(3)
  reversalReason String?   @db.VarChar(500)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("AllocationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, invoiceId, allocationDate])
  @@index([organizationId, paymentId])
}

model InvoiceImportJob {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @db.Uuid
  filename       String                 @db.VarChar(255)
  fileHash       String                 @db.Char(64)
  status         InvoiceImportJobStatus @default(PREVIEWING)
  totalRows      Int                    @default(0)
  validRows      Int                    @default(0)
  invalidRows    Int                    @default(0)
  duplicateRows  Int                    @default(0)
  warningRows    Int                    @default(0)
  fileWarnings   Json?                  @db.JsonB
  failureCode    String?                @db.VarChar(80)
  failureMessage String?                @db.VarChar(500)
  createdById    String                 @db.Uuid
  committedAt    DateTime?              @db.Timestamptz(3)
  cancelledAt    DateTime?              @db.Timestamptz(3)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User               @relation("InvoiceImportCreator", fields: [createdById], references: [id], onDelete: Restrict)
  rows         InvoiceImportRow[]

  @@index([organizationId, status, createdAt])
  @@index([organizationId, fileHash, createdAt])
}

model InvoiceImportRow {
  id                 String                     @id @default(uuid()) @db.Uuid
  organizationId     String                     @db.Uuid
  importJobId        String                     @db.Uuid
  rowNumber          Int
  result             InvoiceImportRowResult
  normalizedPayload  Json                       @db.JsonB
  errors             Json                       @db.JsonB
  warnings           Json                       @db.JsonB
  debtorAction       InvoiceImportDebtorAction?
  matchedDebtorId    String?                    @db.Uuid
  committedInvoiceId String?                    @unique @db.Uuid
  createdAt          DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @db.Timestamptz(3)

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  importJob        InvoiceImportJob @relation(fields: [importJobId], references: [id], onDelete: Restrict)
  matchedDebtor    Debtor?          @relation("ImportMatchedDebtor", fields: [matchedDebtorId], references: [id], onDelete: Restrict)
  committedInvoice Invoice?         @relation("CommittedInvoice", fields: [committedInvoiceId], references: [id], onDelete: Restrict)

  @@unique([importJobId, rowNumber])
  @@index([organizationId, importJobId, result, rowNumber])
  @@index([organizationId, matchedDebtorId])
}

model WhatsAppConnection {
  id                    String                  @id @default(uuid()) @db.Uuid
  organizationId        String                  @db.Uuid
  provider              WhatsAppProvider        @default(META)
  providerBusinessId    String?                 @db.VarChar(100)
  providerPhoneNumberId String?                 @db.VarChar(100)
  displayPhoneNumber    String?                 @db.VarChar(32)
  state                 WhatsAppConnectionState @default(DISCONNECTED)
  lastWebhookAt         DateTime?               @db.Timestamptz(3)
  lastHealthyAt         DateTime?               @db.Timestamptz(3)
  lastFailureCode       String?                 @db.VarChar(80)
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  threads      ConversationThread[]
  messages     ChannelMessage[]
  webhookInbox WebhookInbox[]

  @@unique([organizationId, provider])
  @@unique([provider, providerPhoneNumberId])
  @@index([organizationId, state, createdAt])
}

model ConversationThread {
  id                       String                 @id @default(uuid()) @db.Uuid
  organizationId           String                 @db.Uuid
  connectionId             String                 @db.Uuid
  debtorId                 String?                @db.Uuid
  currentInvoiceId         String?                @db.Uuid
  normalizedCustomerNumber String                 @db.VarChar(32)
  customerDisplayName      String?                @db.VarChar(200)
  matchState               ConversationMatchState @default(UNMATCHED)
  lastMessageAt            DateTime?              @db.Timestamptz(3)
  createdAt                DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime               @updatedAt @db.Timestamptz(3)

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connection     WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  debtor         Debtor?            @relation(fields: [debtorId], references: [id], onDelete: Restrict)
  currentInvoice Invoice?           @relation("CurrentInvoiceThread", fields: [currentInvoiceId], references: [id], onDelete: Restrict)
  messages       ChannelMessage[]

  @@unique([organizationId, normalizedCustomerNumber])
  @@index([organizationId, debtorId, lastMessageAt])
  @@index([organizationId, matchState, lastMessageAt])
}

model ChannelMessage {
  id                String                  @id @default(uuid()) @db.Uuid
  organizationId    String                  @db.Uuid
  connectionId      String                  @db.Uuid
  threadId          String                  @db.Uuid
  invoiceId         String?                 @db.Uuid
  direction         ChannelMessageDirection
  type              ChannelMessageType
  state             ChannelMessageState
  providerMessageId String?                 @db.VarChar(160)
  operationKey      String?                 @db.Uuid
  body              String?                 @db.VarChar(4096)
  safeFailureCode   String?                 @db.VarChar(80)
  approvedById      String?                 @db.Uuid
  approvedAt        DateTime?               @db.Timestamptz(3)
  occurredAt        DateTime                @db.Timestamptz(3)
  createdAt         DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                @updatedAt @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connection   WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  thread       ConversationThread @relation(fields: [threadId], references: [id], onDelete: Restrict)
  invoice      Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  approvedBy   User?              @relation("ChannelMessageApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  mediaAsset   MediaAsset?
  outbox       MessageOutbox?

  @@unique([connectionId, providerMessageId])
  @@unique([organizationId, operationKey])
  @@index([organizationId, threadId, occurredAt, id])
  @@index([organizationId, state, createdAt])
}

model MediaAsset {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String               @db.Uuid
  messageId           String               @unique @db.Uuid
  providerMediaId     String?              @db.VarChar(160)
  objectKey           String?              @unique @db.VarChar(500)
  sha256              String?              @db.Char(64)
  detectedMime        String?              @db.VarChar(80)
  byteSize            Int?
  width               Int?
  height              Int?
  processingState     MediaProcessingState @default(PENDING)
  failureCode         String?              @db.VarChar(80)
  processingStartedAt DateTime?            @db.Timestamptz(3)
  processedAt         DateTime?            @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  message      ChannelMessage         @relation(fields: [messageId], references: [id], onDelete: Restrict)
  evidence     PaymentEvidenceReview?

  @@unique([organizationId, providerMediaId])
  @@index([organizationId, processingState, createdAt])
}

model PaymentEvidenceReview {
  id              String               @id @default(uuid()) @db.Uuid
  organizationId  String               @db.Uuid
  mediaAssetId    String               @unique @db.Uuid
  debtorId        String?              @db.Uuid
  invoiceId       String?              @db.Uuid
  state           PaymentEvidenceState @default(PROCESSING)
  reviewerId      String?              @db.Uuid
  reviewedAt      DateTime?            @db.Timestamptz(3)
  rejectionReason String?              @db.VarChar(500)
  paymentId       String?              @unique @db.Uuid
  operationKey    String?              @db.Uuid
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  mediaAsset   MediaAsset   @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  debtor       Debtor?      @relation(fields: [debtorId], references: [id], onDelete: Restrict)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  reviewer     User?        @relation("EvidenceReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  payment      Payment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([organizationId, operationKey])
  @@index([organizationId, state, createdAt])
  @@index([organizationId, debtorId, createdAt])
}

model WebhookInbox {
  id                  String            @id @default(uuid()) @db.Uuid
  organizationId      String?           @db.Uuid
  connectionId        String?           @db.Uuid
  provider            WhatsAppProvider  @default(META)
  providerEventId     String            @unique @db.VarChar(200)
  payload             Json              @db.JsonB
  signatureVerifiedAt DateTime          @db.Timestamptz(3)
  state               WebhookInboxState @default(PENDING)
  attemptCount        Int               @default(0)
  nextAttemptAt       DateTime          @default(now()) @db.Timestamptz(3)
  leaseOwner          String?           @db.VarChar(100)
  leaseExpiresAt      DateTime?         @db.Timestamptz(3)
  safeErrorCode       String?           @db.VarChar(80)
  processedAt         DateTime?         @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)

  organization Organization?       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connection   WhatsAppConnection? @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@index([state, nextAttemptAt, leaseExpiresAt])
  @@index([organizationId, createdAt])
}

model MessageOutbox {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @db.Uuid
  channelMessageId String             @unique @db.Uuid
  state            MessageOutboxState @default(PENDING)
  attemptCount     Int                @default(0)
  nextAttemptAt    DateTime           @default(now()) @db.Timestamptz(3)
  leaseOwner       String?            @db.VarChar(100)
  leaseExpiresAt   DateTime?          @db.Timestamptz(3)
  safeErrorCode    String?            @db.VarChar(80)
  sentAt           DateTime?          @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  channelMessage ChannelMessage @relation(fields: [channelMessageId], references: [id], onDelete: Restrict)

  @@index([organizationId, state, nextAttemptAt, leaseExpiresAt])
}
