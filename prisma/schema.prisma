generator client {
  provider               = "prisma-client"
  output                 = "../apps/api/src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  OPERATOR
}

enum AccountTokenPurpose {
  INVITATION
  PASSWORD_RESET
}

enum InvoiceImportJobStatus {
  PREVIEWING
  READY
  COMMITTED
  FAILED
  CANCELLED
}

enum InvoiceImportRowResult {
  VALID
  INVALID
  DUPLICATE
  COMMITTED
}

enum InvoiceImportDebtorAction {
  MATCH_EXISTING
  WILL_CREATE
}

enum CommunicationChannel {
  WHATSAPP
  CALL
  EMAIL
  OTHER
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(200)
  timezone  String   @default("Asia/Jakarta") @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  memberships    Membership[]
  auditLogs      AuditLog[]
  accountTokens  AccountToken[]
  debtors        Debtor[]
  invoices       Invoice[]
  payments       Payment[]
  allocations    PaymentAllocation[]
  communications Communication[]
  importJobs     InvoiceImportJob[]
  importRows     InvoiceImportRow[]
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @db.VarChar(320)
  normalizedEmail String   @unique @db.VarChar(320)
  passwordHash    String?  @db.VarChar(100)
  name            String   @db.VarChar(200)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  memberships        Membership[]
  auditLogs          AuditLog[]          @relation("AuditActor")
  accountTokens      AccountToken[]
  createdPayments    Payment[]           @relation("PaymentCreator")
  createdAllocations PaymentAllocation[] @relation("AllocationCreator")
  communications     Communication[]     @relation("CommunicationActor")
  createdImportJobs  InvoiceImportJob[]  @relation("InvoiceImportCreator")
}

model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  organizationId String         @db.Uuid
  role           MembershipRole
  isActive       Boolean        @default(true)
  invitedAt      DateTime?      @db.Timestamptz(3)
  acceptedAt     DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sessions     Session[]

  @@unique([userId, organizationId])
  @@index([organizationId, isActive])
}

model AccountToken {
  id             String              @id @default(uuid()) @db.Uuid
  tokenHash      String              @unique @db.VarChar(64)
  purpose        AccountTokenPurpose
  userId         String              @db.Uuid
  organizationId String              @db.Uuid
  expiresAt      DateTime            @db.Timestamptz(3)
  consumedAt     DateTime?           @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, purpose, expiresAt])
  @@index([userId, purpose, expiresAt])
}

model Session {
  id             String         @id @default(uuid()) @db.Uuid
  tokenHash      String         @unique @db.VarChar(64)
  userId         String         @db.Uuid
  organizationId String         @db.Uuid
  role           MembershipRole
  expiresAt      DateTime       @db.Timestamptz(3)
  revokedAt      DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  membership Membership @relation(fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  @@index([organizationId, expiresAt])
  @@index([userId, expiresAt])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  actorId        String?  @db.Uuid
  action         String   @db.VarChar(80)
  entityType     String?  @db.VarChar(80)
  entityId       String?  @db.Uuid
  requestId      String   @db.VarChar(128)
  metadata       Json?    @db.JsonB
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
}

model Debtor {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  code           String?   @db.VarChar(50)
  normalizedCode String?   @db.VarChar(50)
  name           String    @db.VarChar(200)
  normalizedName String    @db.VarChar(200)
  contactName    String?   @db.VarChar(200)
  phoneNumber    String?   @db.VarChar(50)
  email          String?   @db.VarChar(320)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoices     Invoice[]
  payments     Payment[]
  importRows   InvoiceImportRow[] @relation("ImportMatchedDebtor")

  @@index([organizationId, deletedAt])
  @@index([organizationId, name])
  @@index([organizationId, normalizedName, deletedAt])
}

model Invoice {
  id                      String    @id @default(uuid()) @db.Uuid
  organizationId          String    @db.Uuid
  debtorId                String    @db.Uuid
  invoiceNumber           String    @db.VarChar(50)
  normalizedInvoiceNumber String    @db.VarChar(50)
  invoiceDate             DateTime  @db.Date
  dueDate                 DateTime  @db.Date
  originalAmount          Decimal   @db.Decimal(18, 2)
  description             String?   @db.VarChar(1000)
  createdAt               DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt               DateTime? @db.Timestamptz(3)

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  debtor         Debtor              @relation(fields: [debtorId], references: [id], onDelete: Restrict)
  allocations    PaymentAllocation[]
  communications Communication[]
  importRow      InvoiceImportRow?   @relation("CommittedInvoice")

  @@index([organizationId, dueDate])
  @@index([organizationId, debtorId])
  @@index([organizationId, deletedAt])
}

model Communication {
  id               String               @id @default(uuid()) @db.Uuid
  organizationId   String               @db.Uuid
  invoiceId        String               @db.Uuid
  actorId          String               @db.Uuid
  operationKey     String               @db.Uuid
  occurredAt       DateTime             @db.Timestamptz(3)
  channel          CommunicationChannel
  notes            String               @db.VarChar(2000)
  nextFollowUpDate DateTime?            @db.Date
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  actor        User         @relation("CommunicationActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([organizationId, operationKey])
  @@index([organizationId, invoiceId, occurredAt])
  @@index([organizationId, createdAt])
}

model Payment {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  debtorId         String   @db.Uuid
  paymentDate      DateTime @db.Date
  amount           Decimal  @db.Decimal(18, 2)
  bankReference    String?  @db.VarChar(100)
  isOpeningBalance Boolean  @default(false)
  createdById      String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  debtor       Debtor              @relation(fields: [debtorId], references: [id], onDelete: Restrict)
  createdBy    User                @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  allocations  PaymentAllocation[]

  @@index([organizationId, paymentDate])
  @@index([organizationId, debtorId])
}

model PaymentAllocation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  paymentId      String    @db.Uuid
  invoiceId      String    @db.Uuid
  amount         Decimal   @db.Decimal(18, 2)
  allocationDate DateTime  @db.Date
  createdById    String    @db.Uuid
  reversedAt     DateTime? @db.Timestamptz(3)
  reversalReason String?   @db.VarChar(500)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("AllocationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, invoiceId, allocationDate])
  @@index([organizationId, paymentId])
}

model InvoiceImportJob {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @db.Uuid
  filename       String                 @db.VarChar(255)
  fileHash       String                 @db.Char(64)
  status         InvoiceImportJobStatus @default(PREVIEWING)
  totalRows      Int                    @default(0)
  validRows      Int                    @default(0)
  invalidRows    Int                    @default(0)
  duplicateRows  Int                    @default(0)
  warningRows    Int                    @default(0)
  fileWarnings   Json?                  @db.JsonB
  failureCode    String?                @db.VarChar(80)
  failureMessage String?                @db.VarChar(500)
  createdById    String                 @db.Uuid
  committedAt    DateTime?              @db.Timestamptz(3)
  cancelledAt    DateTime?              @db.Timestamptz(3)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User               @relation("InvoiceImportCreator", fields: [createdById], references: [id], onDelete: Restrict)
  rows         InvoiceImportRow[]

  @@index([organizationId, status, createdAt])
  @@index([organizationId, fileHash, createdAt])
}

model InvoiceImportRow {
  id                 String                     @id @default(uuid()) @db.Uuid
  organizationId     String                     @db.Uuid
  importJobId        String                     @db.Uuid
  rowNumber          Int
  result             InvoiceImportRowResult
  normalizedPayload  Json                       @db.JsonB
  errors             Json                       @db.JsonB
  warnings           Json                       @db.JsonB
  debtorAction       InvoiceImportDebtorAction?
  matchedDebtorId    String?                    @db.Uuid
  committedInvoiceId String?                    @unique @db.Uuid
  createdAt          DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @db.Timestamptz(3)

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  importJob        InvoiceImportJob @relation(fields: [importJobId], references: [id], onDelete: Restrict)
  matchedDebtor    Debtor?          @relation("ImportMatchedDebtor", fields: [matchedDebtorId], references: [id], onDelete: Restrict)
  committedInvoice Invoice?         @relation("CommittedInvoice", fields: [committedInvoiceId], references: [id], onDelete: Restrict)

  @@unique([importJobId, rowNumber])
  @@index([organizationId, importJobId, result, rowNumber])
  @@index([organizationId, matchedDebtorId])
}
