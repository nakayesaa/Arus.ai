{
  "name": "@arus/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/server.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "vitest run --maxWorkers=1 --no-file-parallelism"
  },
  "dependencies": {
    "@arus/domain": "0.1.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "bcrypt": "6.0.0",
    "busboy": "^1.6.0",
    "cors": "2.8.6",
    "csv-parse": "^7.0.1",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "helmet": "8.3.0",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/busboy": "^1.5.4",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.0",
    "supertest": "7.2.2",
    "tsx": "4.23.1"
  }
}
