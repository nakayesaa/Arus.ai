# Runtime
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
LOG_LEVEL=info

# PostgreSQL
POSTGRES_DB=arus_ai
POSTGRES_USER=arus
POSTGRES_PASSWORD=arus_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://arus:arus_local_only@localhost:5432/arus_ai?schema=public
DIRECT_DATABASE_URL=postgresql://arus:arus_local_only@localhost:5432/arus_ai?schema=public
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# Authentication
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=168
AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_MAX_ATTEMPTS=10
TRUST_PROXY_HOPS=0

# Account lifecycle email. Local files are forbidden in production.
EMAIL_DELIVERY_MODE=file
EMAIL_FROM=Arus <accounts@example.com>
RESEND_API_KEY=
INVITATION_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_RESET_WINDOW_MS=900000
PASSWORD_RESET_MAX_ATTEMPTS=5

# Synthetic demo/test only
DEMO_SEED_PASSWORD=replace-this-demo-password
DEMO_TODAY=

# Optional error tracking
SENTRY_DSN=

# Encrypted logical backup
BACKUP_DIR=./backups
BACKUP_ENCRYPTION_PASSPHRASE=replace-with-a-long-random-backup-secret
