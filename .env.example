# Runtime
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
LOG_LEVEL=info

# PostgreSQL
POSTGRES_DB=arus_ai
POSTGRES_USER=arus
POSTGRES_PASSWORD=arus_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://arus:arus_local_only@localhost:5432/arus_ai?schema=public
DIRECT_DATABASE_URL=postgresql://arus:arus_local_only@localhost:5432/arus_ai?schema=public

# Authentication
SESSION_SECRET=replace-with-at-least-32-random-characters

# Synthetic demo/test only
DEMO_SEED_PASSWORD=replace-this-demo-password
DEMO_TODAY=

# Optional error tracking
SENTRY_DSN=
